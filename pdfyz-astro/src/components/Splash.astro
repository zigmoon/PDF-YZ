---
// pré-accueil : import, sessions, marque
// Extrait de ../index.html, lignes 2215–2282. Balisage d'origine, non réécrit.
---

<!-- PRE-HOME (splash) -->
<div class="splash-screen" id="splash">
    <div class="splash-shell">
        <header class="splash-header">
            <img class="splash-logo" src="logo-pdf-yz.svg" alt="PDF-YZ" width="44" height="44" decoding="async" />
            <div class="splash-brand-text">
                <span class="splash-title">PDF&#8209;YZ</span>
                <span class="splash-sub">Edit, annotate &amp; export — offline.</span>
            </div>
            <button class="splash-theme" id="themeToggle" type="button" aria-pressed="false" aria-label="Switch to dark theme" title="Switch to dark theme">
                <svg class="splash-theme-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.1"/><path d="M12 2.7v2M12 19.3v2M2.7 12h2M19.3 12h2M5.5 5.5l1.4 1.4M17.1 17.1l1.4 1.4M18.5 5.5l-1.4 1.4M6.9 17.1l-1.4 1.4"/></svg>
                <svg class="splash-theme-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 14.1A8.7 8.7 0 0 1 9.9 3.4a8.7 8.7 0 1 0 10.7 10.7z"/></svg>
            </button>
        </header>

        <div class="splash-body">
            <section class="splash-import" aria-label="Open a document">
                <div class="splash-drop-zone" id="dropZone" role="button" tabindex="0" aria-label="Drop a PDF here, or press Enter to browse">
                    <svg class="splash-drop-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="12" y2="12"/><line x1="15" y1="15" x2="12" y2="12"/></svg>
                    <strong>Drop a PDF here</strong>
                    <span class="splash-drop-hint">or click to browse your files</span>
                </div>
                <div class="splash-btn-row" id="splashBtnRow">
                    <button class="splash-btn primary" id="btnOpen" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                        Open PDF
                    </button>
                    <button class="splash-btn" id="btnBlank" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                        Blank PDF
                    </button>
                </div>
                <div class="splash-loading" id="splashLoading" role="status" aria-live="polite">
                    <div class="splash-loading-row">
                        <div class="loader-spinner" aria-hidden="true"></div>
                        <span id="splashLoadMsg" class="splash-loading-msg">Loading PDF…</span>
                        <span id="splashLoadPct" class="splash-loading-pct">0%</span>
                    </div>
                    <div class="splash-progress indeterminate" id="splashProgress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                        <div class="splash-progress-bar" id="splashProgressBar"></div>
                    </div>
                </div>
            </section>

            <section class="splash-resume" id="splashResume" role="region" aria-label="Previous sessions">
                <div class="splash-resume-head">
                    <div class="splash-resume-title">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <span>Previous sessions</span>
                        <span class="splash-count" id="splashSessionsCount" hidden>0</span>
                    </div>
                    <div class="splash-resume-tools">
                        <label class="splash-search" for="splashSessionsSearch">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input type="search" id="splashSessionsSearch" placeholder="Search…" autocomplete="off" spellcheck="false" aria-label="Search previous sessions" />
                        </label>
                        <button class="splash-resume-all" id="splashResumeAllBtn" type="button" title="Open the full sessions manager">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                            All
                        </button>
                    </div>
                </div>
                <div class="splash-sessions" id="splashSessionsList"></div>
            </section>
        </div>
    </div>
</div>
