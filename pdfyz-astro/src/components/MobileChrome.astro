<div class="mobile-sheet-layer" id="mobileSheetLayer" aria-hidden="true">
    <section class="mobile-sheet" id="mobileAddSheet" role="dialog" aria-modal="true" aria-labelledby="mobileAddTitle">
        <div class="mobile-sheet-handle" aria-hidden="true"></div>
        <div class="mobile-sheet-head">
            <strong id="mobileAddTitle">Ajouter à la page</strong>
            <button class="mobile-sheet-close" type="button" aria-label="Fermer"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
        </div>
        <div class="mobile-tool-grid">
            <button class="mobile-tool-action" type="button" data-mobile-tool="text"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg><span>Texte</span></button>
            <button class="mobile-tool-action" type="button" data-mobile-tool="image"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg><span>Image</span></button>
            <button class="mobile-tool-action" type="button" data-mobile-tool="note"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg><span>Note</span></button>
            <button class="mobile-tool-action" type="button" data-mobile-tool="draw"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg><span>Dessiner</span></button>
            <button class="mobile-tool-action" type="button" data-mobile-tool="highlight"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m9 11-6 6v4h4l6-6"/><path d="m22 12-7-7-6 6 7 7Z"/></svg><span>Surligner</span></button>
            <button class="mobile-tool-action" type="button" data-mobile-tool="eraser"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m7 21-4.35-4.35a2 2 0 0 1 0-2.83l8.5-8.5a2 2 0 0 1 2.83 0L21 12.5a2 2 0 0 1 0 2.83L13.83 22H7z"/><path d="m5 13 6 6"/></svg><span>Gomme</span></button>
            <button class="mobile-tool-action" type="button" data-mobile-tool="signature"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M2 19.5c1.5-2 4-5 6.5-5s4 3 6.5 3 4.5-2.5 7-5.5"/><line x1="2" y1="22" x2="22" y2="22"/></svg><span>Signature</span></button>
        </div>
    </section>

    <section class="mobile-sheet" id="mobileMoreSheet" role="dialog" aria-modal="true" aria-labelledby="mobileMoreTitle">
        <div class="mobile-sheet-handle" aria-hidden="true"></div>
        <div class="mobile-sheet-head">
            <strong id="mobileMoreTitle">Tous les outils</strong>
            <button class="mobile-sheet-close" type="button" aria-label="Fermer"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
        </div>
        <div class="mobile-tool-section">
            <span class="mobile-tool-title">Édition</span>
            <div class="mobile-tool-grid">
                <button class="mobile-tool-action" type="button" data-mobile-tool="select"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z"/><path d="M13 13l6 6"/></svg><span>Sélection</span></button>
                <button class="mobile-tool-action" id="mobileUndo" type="button" data-mobile-proxy="btnUndo"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="1 4 1 10 7 10"/><path d="M3.5 15a9 9 0 1 0 2.1-9.4L1 10"/></svg><span>Annuler</span></button>
                <button class="mobile-tool-action" id="mobileRedo" type="button" data-mobile-proxy="btnRedo"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="23 4 23 10 17 10"/><path d="M20.5 15a9 9 0 1 1-2.1-9.4L23 10"/></svg><span>Rétablir</span></button>
                <button class="mobile-tool-action" type="button" data-mobile-proxy="btnNewDoc"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="12" x2="12" y2="18"/><line x1="9" y1="15" x2="15" y2="15"/></svg><span>Nouveau</span></button>
            </div>
        </div>
        <div class="mobile-tool-section">
            <span class="mobile-tool-title">Document</span>
            <div class="mobile-tool-grid">
                <button class="mobile-tool-action" type="button" data-mobile-proxy="btnImpoToolbar"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="2" y="2" width="20" height="20" rx="2"/><line x1="12" y1="2" x2="12" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/></svg><span>Imposition</span></button>
                <button class="mobile-tool-action" type="button" data-mobile-proxy="btnCropToolbar"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 1v15a2 2 0 0 0 2 2h15"/><path d="M1 6h15a2 2 0 0 1 2 2v15"/></svg><span>Recadrer</span></button>
                <button class="mobile-tool-action" type="button" data-mobile-proxy="btnICC"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="8" r="5"/><circle cx="8" cy="14" r="5"/><circle cx="16" cy="14" r="5"/></svg><span>Profils ICC</span></button>
                <button class="mobile-tool-action" type="button" data-mobile-proxy="btnPrefs"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21h-4v-.2a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1-2.8-2.8.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3v-4h.2a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1 2.8-2.8.1.1a1.7 1.7 0 0 0 1.8.3 1.7 1.7 0 0 0 1-1.5V3h4v.2a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1 2.8 2.8-.1.1a1.7 1.7 0 0 0-.3 1.8 1.7 1.7 0 0 0 1.5 1h.2v4h-.2a1.7 1.7 0 0 0-1.4 1Z"/></svg><span>Préférences</span></button>
            </div>
        </div>
        <div class="mobile-tool-section">
            <button class="mobile-tool-action emphasis" type="button" data-mobile-proxy="btnSaveFixed" style="width:100%;min-height:52px;flex-direction:row;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg><span>Exporter le PDF</span></button>
            <button class="mobile-tool-action" type="button" data-mobile-proxy="btnConvertSp" style="width:100%;min-height:52px;flex-direction:row;margin-top:8px;"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg><span>Convertir en .sp (SuperPrint)</span></button>
        </div>
    </section>
</div>
