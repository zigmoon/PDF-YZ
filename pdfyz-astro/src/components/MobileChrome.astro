        <span>Recherche</span>
    </button>
    <button class="mobile-footer-btn primary" id="mobileModify" type="button" aria-label="Modifier la page" aria-pressed="false">
        <span class="mobile-footer-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m14.5 7.5 2 2"/><path d="M7 17l.7-3.2 7.8-7.8 2.5 2.5-7.8 7.8Z"/></svg></span>
        <span>Modifier</span>
    </button>
    <button class="mobile-footer-btn" id="mobileAdd" type="button" aria-label="Ajouter un élément" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
        <span>Ajouter</span>
    </button>
    <button class="mobile-footer-btn more" id="mobileMore" type="button" aria-label="Plus d’outils" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="none"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg>
        <span>Plus</span>
    </button>
