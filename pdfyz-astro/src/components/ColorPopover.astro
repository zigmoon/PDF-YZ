<!-- COLOUR POPOVER (tool colour / selected object colour) -->
<div class="color-pop" id="colorPop" role="dialog" aria-label="Couleur">
    <div class="color-pop-head" id="colorPopHead">
        <span class="color-pop-grip">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="9" cy="6" r="1.6"/><circle cx="15" cy="6" r="1.6"/><circle cx="9" cy="12" r="1.6"/><circle cx="15" cy="12" r="1.6"/><circle cx="9" cy="18" r="1.6"/><circle cx="15" cy="18" r="1.6"/></svg>
            <span class="color-pop-title" id="colorPopTitle">Couleur</span>
        </span>
        <button class="color-pop-close" id="colorPopClose" type="button" aria-label="Fermer">✕</button>
    </div>
    <div class="color-pop-swatches" id="colorPopSwatches"></div>
    <label class="color-pop-custom">
        <input type="color" id="colorPopInput" value="#ef4444" />
        <span>Autre couleur…</span>
    </label>
</div>
