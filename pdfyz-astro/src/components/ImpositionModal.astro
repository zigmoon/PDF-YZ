                        <div class="impo-card-title">20 pages</div>
                        <div class="impo-card-desc">5×4 — 20 pages/sheet</div>
                    </div>
                    <div class="impo-card" data-layout="24up">
                        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1"><rect x="2" y="2" width="6" height="10" rx="1"/><rect x="9" y="2" width="6" height="10" rx="1"/><rect x="16" y="2" width="6" height="10" rx="1"/><rect x="23" y="2" width="6" height="10" rx="1"/><rect x="30" y="2" width="6" height="10" rx="1"/><rect x="37" y="2" width="6" height="10" rx="1"/><rect x="2" y="13" width="6" height="10" rx="1"/><rect x="9" y="13" width="6" height="10" rx="1"/><rect x="16" y="13" width="6" height="10" rx="1"/><rect x="23" y="13" width="6" height="10" rx="1"/><rect x="30" y="13" width="6" height="10" rx="1"/><rect x="37" y="13" width="6" height="10" rx="1"/><rect x="2" y="24" width="6" height="10" rx="1"/><rect x="9" y="24" width="6" height="10" rx="1"/><rect x="16" y="24" width="6" height="10" rx="1"/><rect x="23" y="24" width="6" height="10" rx="1"/><rect x="30" y="24" width="6" height="10" rx="1"/><rect x="37" y="24" width="6" height="10" rx="1"/><rect x="2" y="35" width="6" height="10" rx="1"/><rect x="9" y="35" width="6" height="10" rx="1"/><rect x="16" y="35" width="6" height="10" rx="1"/><rect x="23" y="35" width="6" height="10" rx="1"/><rect x="30" y="35" width="6" height="10" rx="1"/><rect x="37" y="35" width="6" height="10" rx="1"/></svg>
                        <div class="impo-card-title">24 pages</div>
                        <div class="impo-card-desc">6×4 — 24 pages/sheet</div>
                    </div>
                    <div class="impo-card" data-layout="32up">
                        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="0.8"><rect x="2" y="2" width="5" height="10" rx="0.5"/><rect x="8" y="2" width="5" height="10" rx="0.5"/><rect x="14" y="2" width="5" height="10" rx="0.5"/><rect x="20" y="2" width="5" height="10" rx="0.5"/><rect x="26" y="2" width="5" height="10" rx="0.5"/><rect x="32" y="2" width="5" height="10" rx="0.5"/><rect x="38" y="2" width="5" height="10" rx="0.5"/><rect x="44" y="2" width="2" height="10" rx="0.5"/><rect x="2" y="13" width="5" height="10" rx="0.5"/><rect x="8" y="13" width="5" height="10" rx="0.5"/><rect x="14" y="13" width="5" height="10" rx="0.5"/><rect x="20" y="13" width="5" height="10" rx="0.5"/><rect x="26" y="13" width="5" height="10" rx="0.5"/><rect x="32" y="13" width="5" height="10" rx="0.5"/><rect x="38" y="13" width="5" height="10" rx="0.5"/><rect x="44" y="13" width="2" height="10" rx="0.5"/><rect x="2" y="24" width="5" height="10" rx="0.5"/><rect x="8" y="24" width="5" height="10" rx="0.5"/><rect x="14" y="24" width="5" height="10" rx="0.5"/><rect x="20" y="24" width="5" height="10" rx="0.5"/><rect x="26" y="24" width="5" height="10" rx="0.5"/><rect x="32" y="24" width="5" height="10" rx="0.5"/><rect x="38" y="24" width="5" height="10" rx="0.5"/><rect x="44" y="24" width="2" height="10" rx="0.5"/><rect x="2" y="35" width="5" height="10" rx="0.5"/><rect x="8" y="35" width="5" height="10" rx="0.5"/><rect x="14" y="35" width="5" height="10" rx="0.5"/><rect x="20" y="35" width="5" height="10" rx="0.5"/><rect x="26" y="35" width="5" height="10" rx="0.5"/><rect x="32" y="35" width="5" height="10" rx="0.5"/><rect x="38" y="35" width="5" height="10" rx="0.5"/><rect x="44" y="35" width="2" height="10" rx="0.5"/></svg>
                        <div class="impo-card-title">32 pages</div>
                        <div class="impo-card-desc">8×4 — 32 pages/sheet</div>
                    </div>
                    <div class="impo-card" data-layout="64up">
                        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="0.7"><rect x="2" y="2" width="5" height="5" rx="0.5"/><rect x="8" y="2" width="5" height="5" rx="0.5"/><rect x="14" y="2" width="5" height="5" rx="0.5"/><rect x="20" y="2" width="5" height="5" rx="0.5"/><rect x="26" y="2" width="5" height="5" rx="0.5"/><rect x="32" y="2" width="5" height="5" rx="0.5"/><rect x="38" y="2" width="5" height="5" rx="0.5"/><rect x="44" y="2" width="2" height="5" rx="0.5"/><rect x="2" y="8" width="5" height="5" rx="0.5"/><rect x="8" y="8" width="5" height="5" rx="0.5"/><rect x="14" y="8" width="5" height="5" rx="0.5"/><rect x="20" y="8" width="5" height="5" rx="0.5"/><rect x="26" y="8" width="5" height="5" rx="0.5"/><rect x="32" y="8" width="5" height="5" rx="0.5"/><rect x="38" y="8" width="5" height="5" rx="0.5"/><rect x="44" y="8" width="2" height="5" rx="0.5"/><rect x="2" y="14" width="5" height="5" rx="0.5"/><rect x="8" y="14" width="5" height="5" rx="0.5"/><rect x="14" y="14" width="5" height="5" rx="0.5"/><rect x="20" y="14" width="5" height="5" rx="0.5"/><rect x="26" y="14" width="5" height="5" rx="0.5"/><rect x="32" y="14" width="5" height="5" rx="0.5"/><rect x="38" y="14" width="5" height="5" rx="0.5"/><rect x="44" y="14" width="2" height="5" rx="0.5"/><rect x="2" y="20" width="5" height="5" rx="0.5"/><rect x="8" y="20" width="5" height="5" rx="0.5"/><rect x="14" y="20" width="5" height="5" rx="0.5"/><rect x="20" y="20" width="5" height="5" rx="0.5"/><rect x="26" y="20" width="5" height="5" rx="0.5"/><rect x="32" y="20" width="5" height="5" rx="0.5"/><rect x="38" y="20" width="5" height="5" rx="0.5"/><rect x="44" y="20" width="2" height="5" rx="0.5"/><rect x="2" y="26" width="5" height="5" rx="0.5"/><rect x="8" y="26" width="5" height="5" rx="0.5"/><rect x="14" y="26" width="5" height="5" rx="0.5"/><rect x="20" y="26" width="5" height="5" rx="0.5"/><rect x="26" y="26" width="5" height="5" rx="0.5"/><rect x="32" y="26" width="5" height="5" rx="0.5"/><rect x="38" y="26" width="5" height="5" rx="0.5"/><rect x="44" y="26" width="2" height="5" rx="0.5"/><rect x="2" y="32" width="5" height="5" rx="0.5"/><rect x="8" y="32" width="5" height="5" rx="0.5"/><rect x="14" y="32" width="5" height="5" rx="0.5"/><rect x="20" y="32" width="5" height="5" rx="0.5"/><rect x="26" y="32" width="5" height="5" rx="0.5"/><rect x="32" y="32" width="5" height="5" rx="0.5"/><rect x="38" y="32" width="5" height="5" rx="0.5"/><rect x="44" y="32" width="2" height="5" rx="0.5"/><rect x="2" y="38" width="5" height="5" rx="0.5"/><rect x="8" y="38" width="5" height="5" rx="0.5"/><rect x="14" y="38" width="5" height="5" rx="0.5"/><rect x="20" y="38" width="5" height="5" rx="0.5"/><rect x="26" y="38" width="5" height="5" rx="0.5"/><rect x="32" y="38" width="5" height="5" rx="0.5"/><rect x="38" y="38" width="5" height="5" rx="0.5"/><rect x="44" y="38" width="2" height="5" rx="0.5"/><rect x="2" y="44" width="5" height="2" rx="0.5"/><rect x="8" y="44" width="5" height="2" rx="0.5"/><rect x="14" y="44" width="5" height="2" rx="0.5"/><rect x="20" y="44" width="5" height="2" rx="0.5"/><rect x="26" y="44" width="5" height="2" rx="0.5"/><rect x="32" y="44" width="5" height="2" rx="0.5"/><rect x="38" y="44" width="5" height="2" rx="0.5"/><rect x="44" y="44" width="2" height="2" rx="0.5"/></svg>
