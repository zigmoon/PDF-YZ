            <!-- Sheet settings -->
            <div class="impo-section">
                <div class="impo-section-title">Sheet</div>
                <div class="impo-opts">
                    <div class="impo-opt">
                        <label>Sheet size</label>
                        <select id="impoSheetSize">
                            <option value="auto" selected>Auto — 2 × page size</option>
                            <option value="a5">A5 (148×210 mm)</option>
                            <option value="a4">A4 (210×297 mm)</option>
                            <option value="a3">A3 (297×420 mm)</option>
                            <option value="a2">A2 (420×594 mm)</option>
                            <option value="sra3">SRA3 (320×450 mm)</option>
                            <option value="sra4">SRA4 (225×320 mm)</option>
                            <option value="letter">Letter (8.5×11 in)</option>
                            <option value="legal">Legal (8.5×14 in)</option>
                            <option value="tabloid">Tabloid (11×17 in)</option>
                            <option value="custom">Custom…</option>
                        </select>
                    </div>
                    <div class="impo-opt">
                        <label>Orientation</label>
                        <select id="impoOrientation">
                            <option value="auto">Auto (best fit)</option>
                            <option value="portrait">Portrait</option>
                            <option value="landscape">Landscape</option>
                        </select>
                    </div>
                </div>
                <!-- Custom sheet size -->
                <div class="impo-custom-row" id="impoCustomRow">
                    <div class="impo-opt">
                        <label>Width</label>
                        <input type="number" id="impoCustomW" value="210" min="10" step="0.1">
                    </div>
                    <div class="impo-opt">
                        <label>Height</label>
                        <input type="number" id="impoCustomH" value="297" min="10" step="0.1">
                    </div>
                    <div class="impo-opt">
                        <label>Unit</label>
                        <select id="impoCustomUnit">
                            <option value="mm" selected>mm</option>
                            <option value="in">inches</option>
                            <option value="pt">points</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Spacing -->
            <div class="impo-section">
                <div class="impo-section-title">Spacing (mm)</div>
                <div class="impo-opts">
                    <div class="impo-opt">
                        <label>Gutter (between pages)</label>
                        <input type="number" id="impoGutter" value="0" min="0" max="50" step="0.5">
                    </div>
                    <div class="impo-opt">
                        <label>Bleed</label>
                        <input type="number" id="impoBleed" value="0" min="0" max="20" step="0.5">
                    </div>
                </div>
                <div class="impo-opts" style="margin-top:8px;">
                    <div class="impo-opt">
                        <label>Margin Top / Bottom</label>
                        <div class="impo-opt-row">
                            <div class="impo-opt"><input type="number" id="impoMarginT" value="0" min="0" max="80" step="0.5" placeholder="Top"></div>
                            <div class="impo-opt"><input type="number" id="impoMarginB" value="0" min="0" max="80" step="0.5" placeholder="Bottom"></div>
                        </div>
                    </div>
                    <div class="impo-opt">
                        <label>Margin Left / Right</label>
                        <div class="impo-opt-row">
                            <div class="impo-opt"><input type="number" id="impoMarginL" value="0" min="0" max="80" step="0.5" placeholder="Left"></div>
                            <div class="impo-opt"><input type="number" id="impoMarginR" value="0" min="0" max="80" step="0.5" placeholder="Right"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Options -->
            <div class="impo-section">
                <div class="impo-section-title">Options</div>
                <div class="impo-opts">
                    <div class="impo-opt">
                        <label>Pages</label>
                        <select id="impoPageRange">
                            <option value="all">All pages</option>
                            <option value="custom">Custom range…</option>
                        </select>
                    </div>
                    <div class="impo-opt" id="impoRangeOpt" style="display:none;">
                        <label>Range (e.g. 1-4, 7, 10-12)</label>
                        <input type="text" id="impoRangeInput" placeholder="1-4, 7, 10-12">
                    </div>
                    <div class="impo-opt">
                        <label>Page order</label>
                        <select id="impoPageOrder">
                            <option value="ltr-ttb">Left→Right, Top→Bottom</option>
                            <option value="rtl-ttb">Right→Left, Top→Bottom</option>
                            <option value="ltr-btt">Left→Right, Bottom→Top</option>
                            <option value="ttb-ltr">Top→Bottom, Left→Right</option>
                        </select>
                    </div>
                </div>
                <div style="display:flex; flex-direction:column; gap:8px; margin-top:10px;">
                    <label class="impo-check"><input type="checkbox" id="impoCropMarks"> Crop marks</label>
                    <label class="impo-check"><input type="checkbox" id="impoAutoRotate" checked> Auto-rotate pages to fit</label>
                </div>
            </div>

            <!-- Preview -->
            <div class="impo-section">
                <div class="impo-section-title">Print order <span id="impoOrderSummary" style="text-transform:none;letter-spacing:0;font-weight:400;"></span></div>
                <div class="impo-order" id="impoOrderList"></div>
                <div class="impo-preview-box" id="impoPreviewBox" style="margin-top:10px;">
                    <canvas id="impoPreviewCanvas" width="280" height="130"></canvas>
                </div>
            </div>
        </div>
        <div class="impo-footer">
            <button class="props-btn" id="impoCancel">Cancel</button>
            <button class="props-btn action" id="impoApply">Apply Imposition</button>
        </div>
    </div>
</div>
