<!-- IMPOSITION MODAL -->
<div class="impo-modal" id="impoModal">
    <div class="impo-box">
        <div class="impo-header">
            <h3>📐 Imposition Print</h3>
            <div class="impo-desc">Arrange pages on press sheets for professional printing — always in multiples of 4.</div>
        </div>
        <div class="impo-body">
            <!-- Mode: booklet signature (SuperPrint) vs N-up grid -->
            <div class="impo-section">
                <div class="impo-section-title">Imposition type</div>
                <div class="impo-modes" id="impoModes">
                    <div class="impo-mode selected" data-mode="booklet">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h7a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H4z"/><path d="M20 4h-4a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h5z"/></svg>
                        <div class="impo-mode-body">
                            <div class="impo-mode-title">Booklet (signature)</div>
                            <div class="impo-mode-desc">2 pages per sheet side, folded and stapled. Always a multiple of 4.</div>
                        </div>
                    </div>
                    <div class="impo-mode" data-mode="nup">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg>
                        <div class="impo-mode-body">
                            <div class="impo-mode-title">N-up grid</div>
                            <div class="impo-mode-desc">Pages laid out in reading order on a press sheet (handouts, proofs).</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Booklet settings -->
            <div class="impo-section" id="impoBookletSection">
                <div class="impo-section-title">Booklet</div>
                <div class="impo-opts">
                    <div class="impo-opt">
                        <label>Binding</label>
                        <select id="impoBinding">
                            <option value="saddle" selected>Saddle stitch — [n,1] [2,n-1]…</option>
                            <option value="perfect">Perfect bound — [1,2] [3,4]…</option>
                        </select>
                    </div>
                    <div class="impo-opt">
                        <label>Pages per side</label>
                        <select id="impoBookletPerSide" disabled>
                            <option value="2" selected>2 (spread)</option>
                        </select>
                    </div>
                </div>
                <div class="impo-hint" id="impoBookletHint"></div>
            </div>

            <!-- Layout selection (N-up) -->
            <div class="impo-section" id="impoLayoutSection" style="display:none;">
                <div class="impo-section-title">Layout</div>
                <div class="impo-grid">
                    <div class="impo-card selected" data-layout="4up">
