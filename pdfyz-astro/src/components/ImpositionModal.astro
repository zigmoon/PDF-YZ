                    <div class="impo-card" data-layout="16up">
                        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2" y="2" width="10" height="10" rx="1"/><rect x="14" y="2" width="10" height="10" rx="1"/><rect x="26" y="2" width="10" height="10" rx="1"/><rect x="38" y="2" width="8" height="10" rx="1"/><rect x="2" y="14" width="10" height="10" rx="1"/><rect x="14" y="14" width="10" height="10" rx="1"/><rect x="26" y="14" width="10" height="10" rx="1"/><rect x="38" y="14" width="8" height="10" rx="1"/><rect x="2" y="26" width="10" height="10" rx="1"/><rect x="14" y="26" width="10" height="10" rx="1"/><rect x="26" y="26" width="10" height="10" rx="1"/><rect x="38" y="26" width="8" height="10" rx="1"/><rect x="2" y="38" width="10" height="8" rx="1"/><rect x="14" y="38" width="10" height="8" rx="1"/><rect x="26" y="38" width="10" height="8" rx="1"/><rect x="38" y="38" width="8" height="8" rx="1"/></svg>
