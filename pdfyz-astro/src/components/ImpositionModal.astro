                        <div class="impo-card-title">4 pages</div>
                        <div class="impo-card-desc">2×2 — 4 pages/sheet</div>
                    </div>
                    <div class="impo-card" data-layout="8up">
                        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="10" height="18" rx="1"/><rect x="14" y="4" width="10" height="18" rx="1"/><rect x="26" y="4" width="10" height="18" rx="1"/><rect x="38" y="4" width="8" height="18" rx="1"/><rect x="2" y="26" width="10" height="18" rx="1"/><rect x="14" y="26" width="10" height="18" rx="1"/><rect x="26" y="26" width="10" height="18" rx="1"/><rect x="38" y="26" width="8" height="18" rx="1"/></svg>
                        <div class="impo-card-title">8 pages</div>
