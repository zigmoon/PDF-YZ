---
// barre d’outils et ses menus
// Extrait de ../index.html, lignes 2349–2444. Balisage d'origine, non réécrit.
---

<!-- FLOATING TOOLBAR -->
<div class="toolbar-container" id="toolbar">
    <!-- 1-2. Undo / Redo first: the two most used actions -->
    <button class="tool-btn" id="btnUndo" title="Annuler (Ctrl+Z)" aria-label="Annuler" disabled>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
    </button>
    <button class="tool-btn" id="btnRedo" title="Rétablir (Ctrl+Y)" aria-label="Rétablir" disabled>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.13-9.36L23 10"/></svg>
    </button>
    <div class="toolbar-divider"></div>
    <!-- 3. Select -->
    <button class="tool-btn active" data-tool="select" title="Sélectionner (V)" aria-label="Sélectionner">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z"/><path d="M13 13l6 6"/></svg>
    </button>
    <!-- 4. Text -->
    <button class="tool-btn" data-tool="text" title="Ajouter du texte (T)" aria-label="Ajouter du texte">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>
    </button>
    <!-- 5. Image -->
    <button class="tool-btn" data-tool="image" title="Insérer une image (I)" aria-label="Insérer une image">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
    </button>
    <!-- 6. Annotations (dessin / surlignage / gomme / signature) -->
    <div class="tool-dropdown" id="annotDrop">
        <button class="tool-btn" id="btnAnnotDrop" title="Annoter : dessin, surlignage, gomme, signature" aria-label="Annoter" aria-expanded="false">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
        </button>
        <div class="tool-dropdown-menu">
            <!-- Draw -->
            <button class="tool-btn" data-tool="draw" title="Dessiner (D)" aria-label="Dessiner">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
            </button>
            <!-- Highlight -->
            <button class="tool-btn" data-tool="highlight" title="Surligner (H)" aria-label="Surligner">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </button>
            <!-- Eraser -->
            <button class="tool-btn" data-tool="eraser" title="Gomme (E)" aria-label="Gomme">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m7 21-4.35-4.35a2 2 0 0 1 0-2.83l8.5-8.5a2 2 0 0 1 2.83 0L21 12.5a2 2 0 0 1 0 2.83L13.83 22H7z"/><path d="m5 13 6 6"/></svg>
            </button>
            <!-- Signature -->
            <button class="tool-btn" data-tool="signature" title="Signature" aria-label="Signature">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M2 19.5c1.5-2 4-5 6.5-5s4 3 6.5 3 4.5-2.5 7-5.5"/><line x1="2" y1="22" x2="22" y2="22"/></svg>
            </button>
        </div>
    </div>
    <div class="toolbar-divider"></div>
    <!-- 7. Convert to a SuperPrint project (.sp) -->
    <button class="tool-btn" id="btnConvertSp" title="Convertir en projet SuperPrint (.sp)" aria-label="Convertir en projet SuperPrint">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg>
    </button>
    <div class="toolbar-divider"></div>
    <!-- 8. Everything else, with labels so nothing is a guessing game -->
    <div class="tool-dropdown" id="moreDrop">
        <button class="tool-btn" id="btnMore" title="Plus d’outils" aria-label="Plus d’outils" aria-expanded="false">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="none"><circle cx="5" cy="12" r="1.9"/><circle cx="12" cy="12" r="1.9"/><circle cx="19" cy="12" r="1.9"/></svg>
        </button>
        <div class="tool-dropdown-menu wide">
            <button class="tool-btn" id="btnFind" title="Rechercher / remplacer (Ctrl+F)" aria-label="Rechercher / remplacer" aria-pressed="false">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <span>Rechercher</span>
            </button>
            <button class="tool-btn modify-toggle" id="btnModify" title="Déplacer, redimensionner ou supprimer les objets du PDF (M)" aria-label="Modifier la page" aria-pressed="false">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m14.5 7.5 2 2"/><path d="M7 17l.7-3.2 7.8-7.8 2.5 2.5-7.8 7.8Z"/></svg>
                <span>Modifier la page</span>
            </button>
            <button class="tool-btn" id="btnPages" title="Afficher ou masquer les pages" aria-label="Pages">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                <span>Pages</span>
            </button>
            <div class="tool-menu-sep"></div>
            <button class="tool-btn" id="btnImpoToolbar" title="Imposition (plusieurs pages par feuille)" aria-label="Imposition">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2"/><line x1="12" y1="2" x2="12" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="12" y2="7"/><line x1="12" y1="17" x2="22" y2="17"/></svg>
                <span>Imposition</span>
            </button>
            <button class="tool-btn" id="btnCropToolbar" title="Recadrer les pages" aria-label="Recadrer les pages">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.13 1L6 16a2 2 0 0 0 2 2h15"/><path d="M1 6.13L16 6a2 2 0 0 1 2 2v15"/></svg>
                <span>Recadrer</span>
            </button>
            <button class="tool-btn" id="btnICC" title="Profil colorimétrique (ICC)" aria-label="Profil colorimétrique">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5" opacity="0.7"/><circle cx="8" cy="14" r="5" opacity="0.7"/><circle cx="16" cy="14" r="5" opacity="0.7"/></svg>
                <span>Profil couleur</span>
            </button>
            <div class="tool-menu-sep"></div>
            <button class="tool-btn" id="btnNewDoc" title="Nouveau document" aria-label="Nouveau document">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                <span>Nouveau document</span>
            </button>
            <button class="tool-btn" id="btnPrefs" title="Préférences" aria-label="Préférences">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                <span>Préférences</span>
            </button>
        </div>
    </div>
</div>
