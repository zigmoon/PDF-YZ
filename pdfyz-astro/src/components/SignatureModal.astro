---
// modale de signature
// Extrait de ../index.html, lignes 3280–3297. Balisage d'origine, non réécrit.
---

<!-- SIGNATURE MODAL -->
<div class="modal-bg" id="sigModal">
    <div class="modal-box">
        <h3>Draw your signature</h3>
        <canvas id="sigCanvas" width="420" height="140"></canvas>
        <div class="sig-colors">
            <span>Ink</span>
            <div class="sig-swatches" id="sigSwatches"></div>
            <input type="color" id="sigColor" value="#111827" aria-label="Signature colour" />
        </div>
        <div class="modal-actions">
            <button class="props-btn" id="sigClear">Clear</button>
            <button class="props-btn" id="sigCancel">Cancel</button>
            <button class="props-btn action" id="sigApply">Apply</button>
        </div>
    </div>
</div>
