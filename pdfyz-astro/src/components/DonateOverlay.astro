---
// pop-in de don (avant l’invite d’installation)
// Extrait de ../index.html, lignes 2166–2204. Balisage d'origine, non réécrit.
---

<!-- ── Donation pop-in (shown right before PWA install prompt) ── -->
<div id="pdfz-donate-overlay" role="dialog" aria-modal="true" aria-labelledby="pdfz-donate-title">
    <div class="pdfz-donate-shell">
        <button class="pdfz-donate-close" id="pdfz-donate-close-btn" type="button" aria-label="Close">✕ close</button>
        <div id="pdfz-donate-box">
            <div class="pdfz-donate-speed-banner" aria-hidden="true">
                <span class="pdfz-speed-figure"><em>75%+</em> FASTER</span>
                <span class="pdfz-speed-label">on app vs browser</span>
                <span class="pdfz-speed-sub">Install &amp; launch in under 1 second</span>
            </div>
            <div class="pdfz-donate-header">
                <span class="pdfz-donate-eyebrow">PDF-YZ · Independent &amp; Ad-free</span>
                <h2 id="pdfz-donate-title">Install the App — €24 one-time</h2>
                <p>The web version stays 100% free, forever.<br>One-time €24 purchase unlocks PWA install for the <strong>entire app.zigmoon.com collection</strong> — no subscription, no recurring charge.<br>On major version updates (~once a year) the app keeps working; you may be asked for €24 again to get the latest version.</p>
            </div>
            <div class="pdfz-donate-body">
                <span class="pdfz-donate-label">One-time €24 — unlock install for the whole collection</span>
                <div id="pdfz-paypal-container" style="min-height:48px;"></div>
                <p id="pdfz-donate-hint" style="font-size:10px;line-height:1.6;color:#888;margin:0;text-align:center;letter-spacing:0.5px;">
                    Install unlocks automatically once the payment is approved.<br>One-time payment — no subscription, no recurring charge.
                </p>
                <button class="pdfz-donate-skip" id="pdfz-donate-skip-btn" type="button">No thanks — keep using the web version</button>

                <!-- Discrete promo code field (for partners / press / friends) -->
                <details style="margin-top:8px;">
                    <summary style="font-size:9px;letter-spacing:2px;text-transform:uppercase;opacity:0.35;cursor:pointer;outline:none;list-style:none;text-align:center;">have a code?</summary>
                    <div style="display:flex;gap:6px;margin-top:10px;">
                        <input type="text" id="pdfz-donate-code" placeholder="Promo code" autocomplete="off" spellcheck="false"
                               style="flex:1;background:#000;border:1px solid #1a1a1a;color:#fff;padding:8px 10px;font-family:inherit;font-size:11px;letter-spacing:2px;border-radius:4px;outline:none;text-transform:uppercase;" />
                        <button id="pdfz-donate-code-btn" type="button"
                                style="background:#1a1a1a;border:1px solid #333;color:#fff;padding:8px 14px;font-family:inherit;font-size:10px;letter-spacing:1px;text-transform:uppercase;border-radius:4px;cursor:pointer;">OK</button>
                    </div>
                    <div id="pdfz-donate-code-msg" style="font-size:10px;color:#ff6b6b;margin-top:6px;min-height:12px;text-align:center;letter-spacing:0.5px;"></div>
                </details>
            </div>
        </div>
    </div>
</div>
