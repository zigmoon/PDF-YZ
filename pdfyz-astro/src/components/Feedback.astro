---
// chargeur, zone de toasts, toast PWA, glisser-déposer
// Extrait de ../index.html, lignes 2335–2366. Balisage d'origine, non réécrit.
---

<!-- LOADER -->
<div class="loader-overlay" id="loader" role="status" aria-live="polite">
    <div class="loader-card">
        <div class="loader-card-row">
            <div class="loader-spinner" aria-hidden="true"></div>
            <span id="loaderMsg" class="loader-card-msg">Loading…</span>
            <span id="loaderPct" class="loader-card-pct">0%</span>
        </div>
        <div class="loader-progress indeterminate" id="loaderProgress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div class="loader-progress-bar" id="loaderProgressBar"></div>
        </div>
    </div>
</div>

<!-- TOAST -->
<div class="toast-zone" id="toastZone"></div>

<!-- PWA UPDATE TOAST -->
<div class="sw-update-toast" id="swUpdateToast" role="status" aria-live="polite" hidden>
    <span>A new version of PDF-YZ is available.</span>
    <button type="button" id="swUpdateReloadBtn">Reload</button>
    <button type="button" id="swUpdateDismissBtn" class="ghost" aria-label="Dismiss">Later</button>
</div>

<!-- GLOBAL DRAG OVERLAY -->
<div class="drag-overlay" id="dragOverlay">
    <div class="drag-overlay-card">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="12" y2="12"/><line x1="15" y1="15" x2="12" y2="12"/></svg>
        Drop your PDF anywhere
    </div>
</div>
