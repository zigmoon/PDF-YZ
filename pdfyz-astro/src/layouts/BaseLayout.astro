    <link rel="icon" sizes="any" href="favicon.svg" />
    <link rel="apple-touch-icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="manifest" href="manifest.webmanifest" />

    <!-- ─── Feeds & Humans ─── -->
    <link rel="sitemap" type="application/xml" href="sitemap.xml" />
    <link rel="author" type="text/plain" href="humans.txt" />

    <!-- ─── Fonts ─── -->
<!-- ─── Fonts ───
     Servies depuis `vendor/fonts/` : une feuille Google distante rendrait la
     première ouverture impossible sans réseau — donc l'application de bureau
     inutilisable, puisque les service workers ne s'y enregistrent pas. -->
<link href="vendor/fonts/app.css" rel="stylesheet" />



    <!-- ─── Dependencies ───
     `vendor/` est produit par tools/vendor-cdn.mjs (origines dans
     tools/cdn-urls.mjs). Chemins relatifs au document : le site est servi sous
     `/PDF-YZ/`, l'application de bureau à la racine. -->
    <script is:inline src="vendor/tailwind.js"></script>
    <script is:inline src="vendor/pdf-lib.min.js"></script>
    <!-- fontkit is REQUIRED by pdf-lib to embed any custom/Google font. Without it
         every embedFont(bytes) call throws and the exporter silently fell back to
         Helvetica, destroying the document's typography. -->
    <script is:inline src="vendor/fontkit.umd.min.js"></script>

