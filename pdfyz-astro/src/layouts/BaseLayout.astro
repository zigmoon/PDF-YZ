---
/**
 * Coquille du document : <head> d'origine (SEO, Open Graph, icônes, polices,
 * dépendances CDN, JSON-LD) et <body> réduit à un emplacement.
 *
 * Le <head> est repris **tel quel** depuis l'application historique. Ses
 * <script> portent is:inline : Astro ne doit ni les déplacer, ni les regrouper,
 * ni réécrire leurs URL — pdf-lib et fontkit sont des variables globales dont
 * l'ordre de chargement est significatif.
 */
import '../styles/01-base.css';
import '../styles/02-scrollbars.css';
import '../styles/03-prehome.css';
import '../styles/04-chrome.css';
import '../styles/05-donate.css';
import '../styles/06-sessions.css';
import '../styles/07-toolbar.css';
import '../styles/08-tools-mobile.css';
import '../styles/09-canvas-sidebar.css';
import '../styles/10-colour-popover.css';
import '../styles/11-icc-zoom-status.css';
import '../styles/12-properties-toast-loader.css';
import '../styles/13-modals-fabs.css';
import '../styles/14-notes-find-prefs.css';
import '../styles/15-text-editor-thumbs.css';
import '../styles/16-imposition-crop.css';
